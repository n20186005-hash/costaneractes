---
interface Props { lang: 'es' | 'en'; }
const { lang } = Astro.props;
const isEs = lang === 'es';

const copy = isEs ? {
  eyebrow: 'Mejor época para visitar',
  title: 'Estrategia de visita por estación',
  intro: 'Ideas de planificación por estación, no promedios medidos ni pronósticos del río. Confirmá el tiempo y las condiciones locales antes de salir.',
  cols: ['Estación', 'Temperatura', 'Lluvia', 'Río y costa', 'Recomendado para', 'Consejo'],
  rows: [
    ['Verano (dic–feb)', 'Consultar pronóstico', 'Consultar pronóstico', 'No inferir seguridad de baño por la estación', 'Paseo al atardecer, hidratarse', 'Aprovechá la brisa y evitá el mediodía; llevá agua y protector.'],
    ['Otoño (mar–may)', 'Consultar pronóstico', 'Consultar pronóstico', 'Consultar estado del río en el día', 'Caminatas largas, fotografía', 'Elegí la duración según el tiempo y tu comodidad.'],
    ['Invierno (jun–ago)', 'Consultar pronóstico', 'Consultar pronóstico', 'La altura del río requiere información actual', 'Confort térmico, ciclismo', 'Madrugadas y noches frescas: llevá una capa.'],
    ['Primavera (sep–nov)', 'Consultar pronóstico', 'Consultar pronóstico', 'Confirmar condiciones y acceso', 'Observación de aves, naturaleza', 'Clima cambiante: preparate para sol y lluvia el mismo día.']
  ]
} : {
  eyebrow: 'Best time to visit',
  title: 'Season-by-season visiting strategy',
  intro: 'Seasonal planning ideas, not measured climate normals or river forecasts. Check the weather and local conditions before leaving.',
  cols: ['Season', 'Temperature', 'Rain', 'River & shore', 'Best for', 'Tip'],
  rows: [
    ['Summer (Dec–Feb)', 'Check forecast', 'Check forecast', 'Season does not establish swimming safety', 'Sunset strolls, hydration', 'Enjoy the breeze, avoid midday; bring water and sunscreen.'],
    ['Autumn (Mar–May)', 'Check forecast', 'Check forecast', 'Check river conditions on the day', 'Long walks, photography', 'Choose the duration according to the weather and your comfort.'],
    ['Winter (Jun–Aug)', 'Check forecast', 'Check forecast', 'River level requires current information', 'Thermal comfort, cycling', 'Cool mornings and nights: bring a layer.'],
    ['Spring (Sep–Nov)', 'Check forecast', 'Check forecast', 'Confirm conditions and access', 'Birdwatching, nature', 'Changeable weather: prepare for sun and rain on the same day.']
  ]
};
---

<section class="section tone-sand" id="estacion">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h2>{copy.title}</h2>
      <p>{copy.intro}</p>
    </div>
    <div class="table-wrap surface">
      <table class="season-table">
        <thead>
          <tr>{copy.cols.map((c) => <th>{c}</th>)}</tr>
        </thead>
        <tbody>
          {copy.rows.map((r) => (
            <tr>
              <th scope="row">{r[0]}</th>
              {r.slice(1).map((cell) => <td>{cell}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
