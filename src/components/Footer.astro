---
interface Props { lang: 'es' | 'en'; }
const { lang } = Astro.props;
const isEs = lang === 'es';
const prefix = isEs ? '' : '/en';
const copy = isEs ? {
  guide: 'Guía Costanera Corrientes',
  statement: 'Este sitio es un proyecto independiente y sin fines de lucro de información para visitantes. No está afiliado a organismos gubernamentales ni a la administración oficial del atractivo.',
  explore: 'Explorar',
  visit: 'Planificá tu visita',
  history: 'Historia y paisaje',
  map: 'Ubicación',
  information: 'Información',
  privacy: 'Política de privacidad',
  terms: 'Términos de servicio',
  cookies: 'Configuración de cookies',
  source: 'La información del atractivo se contrasta con fuentes públicas de la Municipalidad de la Ciudad de Corrientes, Visit Corrientes y el Instituto Nacional de Promoción Turística. No contiene recomendaciones comerciales.',
  rights: 'Las fotografías mostradas pertenecen a sus respectivos autores y se utilizan aquí como material informativo local. © 2026 Guía Costanera Corrientes. Todos los derechos reservados.'
} : {
  guide: 'Costanera Corrientes Guide',
  statement: 'This website is an independent, non-profit visitor information project. It is not affiliated with any government body or the official management of the attraction.',
  explore: 'Explore',
  visit: 'Plan your visit',
  history: 'History & landscape',
  map: 'Location',
  information: 'Information',
  privacy: 'Privacy policy',
  terms: 'Terms of service',
  cookies: 'Cookie settings',
  source: 'Attraction information is cross-checked against public sources from the Municipality of the City of Corrientes, Visit Corrientes and the National Institute for Tourism Promotion. This guide contains no commercial recommendations.',
  rights: 'The photographs displayed remain the property and copyright of their respective authors and are used here as local informational material. © 2026 Costanera Corrientes Guide. All rights reserved.'
};
---
<footer class="site-footer">
  <div class="container footer-main">
    <section class="footer-brand" aria-label={copy.guide}>
      <img src="/icons/logo.svg" alt="Costanera Corrientes" width="220" height="54" />
      <p>{copy.statement}</p>
    </section>
    <nav class="footer-column" aria-label={copy.explore}>
      <h2>{copy.explore}</h2>
      <a href={`${prefix}/#visita`}>{copy.visit}</a>
      <a href={`${prefix}/#historia`}>{copy.history}</a>
      <a href={`${prefix}/#ubicacion`}>{copy.map}</a>
    </nav>
    <nav class="footer-column" aria-label={copy.information}>
      <h2>{copy.information}</h2>
      <a href={`${prefix}/legal/privacy/`}>{copy.privacy}</a>
      <a href={`${prefix}/legal/terms/`}>{copy.terms}</a>
      <a href={`${prefix}/legal/cookies/`}>{copy.cookies}</a>
    </nav>
  </div>
  <div class="container footer-bottom">
    <p>{copy.source}</p>
    <p>{copy.rights}</p>
  </div>
</footer>
