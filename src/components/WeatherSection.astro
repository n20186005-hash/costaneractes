---

interface Props { lang: 'es' | 'en'; }
const { lang } = Astro.props;
const isEs = lang === 'es';

const L = isEs ? {
  eyebrow: 'Clima en la costanera',
  title: 'Pronóstico para la costanera',
  intro: 'Estimación de modelo, no observación en el paseo ni aviso oficial. No informa nivel del río, calidad del agua, habilitación para baño ni disponibilidad de excursiones.',
  now: 'Ahora',
  feels: 'Sensación',
  rainToday: 'Lluvia hoy',
  wind: 'Viento',
  uv: 'UV',
  humidity: 'Humedad',
  forecast: 'Pronóstico a 7 días',
  updated: 'Actualizado',
  riskTitle: 'Avisos para hoy',
  riskNone: 'Sin recomendaciones adicionales del modelo; no confirma ausencia de alertas oficiales.',
  outfitTitle: 'Vestimenta',
  planTitle: 'Cómo disfrutarlo',
  itemsTitle: 'Para llevar',
  loadError: 'No pudimos cargar el pronóstico en este momento. Volvé a intentar más tarde.',
  loading: 'Cargando pronóstico…',
} : {
  eyebrow: 'Weather on the waterfront',
  title: 'Waterfront weather forecast',
  intro: 'Model estimate, not an on-site observation or official warning. It does not report river level, water quality, swimming permission or excursion availability.',
  now: 'Now',
  feels: 'Feels like',
  rainToday: 'Rain today',
  wind: 'Wind',
  uv: 'UV',
  humidity: 'Humidity',
  forecast: '7-day forecast',
  updated: 'Updated',
  riskTitle: 'Advisories for today',
  riskNone: 'No additional model recommendations; this does not establish an absence of official warnings.',
  outfitTitle: 'What to wear',
  planTitle: 'How to enjoy it',
  itemsTitle: 'What to bring',
  loadError: 'We could not load the forecast right now. Please try again later.',
  loading: 'Loading forecast…',
};

// Forecast is fetched at runtime; a deployed page must not present a frozen build-time snapshot.
const initial = null;

---

<section class="section weather-section" id="clima" data-lang={lang} data-labels={JSON.stringify(L)} data-initial={initial ? JSON.stringify(initial) : ''}>
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{L.eyebrow}</span>
      <h2>{L.title}</h2>
      <p>{L.intro}</p>
    </div>
    <p><a href="https://open-meteo.com/">Open-Meteo</a> · <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a></p>
    <div class="weather-grid">
      <div class="weather-now" id="weather-now">
        <p class="weather-loading">{L.loading}</p>
      </div>
      <div class="weather-forecast" id="weather-forecast">
        <p class="weather-loading">{L.loading}</p>
      </div>
    </div>
    <div class="weather-advice" id="weather-advice" hidden>
      <p class="weather-loading">{L.loading}</p>
    </div>
    <p class="weather-updated" id="weather-updated" hidden></p>
  </div>
</section>

<script is:inline>
  (() => {
    const section = document.getElementById('clima');
    if (!section) return;
    const lang = section.getAttribute('data-lang') || 'es';
    const L = JSON.parse(section.getAttribute('data-labels') || '{}');
    const nowEl = document.getElementById('weather-now');
    const fcEl = document.getElementById('weather-forecast');
    const advEl = document.getElementById('weather-advice');
    const upEl = document.getElementById('weather-updated');
    const lc = lang === 'es' ? 'es-AR' : 'en-US';

    const fmtDay = (iso) => {
      const d = new Date(iso + 'T12:00:00-03:00');
      return new Intl.DateTimeFormat(lc, { weekday: 'short', timeZone: 'America/Argentina/Cordoba' }).format(d);
    };

    const li = (txt) => '<li>' + txt + '</li>';

    function renderAdvice(a) {
      if (!a) return;
      const risk = (a.risk || []);
      const riskHtml = risk.length
        ? '<div class="advice-risk"><div class="advice-risk-head">⚠️ ' + L.riskTitle + '</div><ul>' + risk.map(li).join('') + '</ul></div>'
        : '<div class="advice-risk none"><div class="advice-risk-head">✅ ' + L.riskNone + '</div></div>';

      const block = (title, list, icon) => {
        const arr = list || [];
        if (!arr.length) return '';
        return '<div class="advice-block"><h3>' + icon + ' ' + title + '</h3><ul>' + arr.map(li).join('') + '</ul></div>';
      };

      const blocks = [
        block(L.outfitTitle, a.outfit, '👕'),
        block(L.planTitle, a.plan, '🗺️'),
        block(L.itemsTitle, a.items, '🎒'),
      ].join('');

      advEl.innerHTML = riskHtml + '<div class="advice-grid">' + blocks + '</div>';
      advEl.hidden = false;
    }

    function render(p) {
      const finite = value => typeof value === 'number' && Number.isFinite(value);
      if (!p?.current || !['temp','feels','humidity','wind','uv'].every(k => finite(p.current[k])) ||
          !Array.isArray(p.daily) || !p.daily.length || !p.daily.every(d => ['tmax','tmin','precipProb'].every(k => finite(d[k])) && /^\d{4}-\d{2}-\d{2}$/.test(d.date)) ||
          !Number.isFinite(Date.parse(p.updated))) throw new Error('Invalid weather payload');
      nowEl.innerHTML =
        '<div class="now-card">' +
          '<div class="now-temp"><span class="now-icon">' + p.current.icon + '</span><strong>' + p.current.temp + '°</strong></div>' +
          '<p class="now-label">' + p.current.label + '</p>' +
          '<ul class="now-meta">' +
            '<li><span>' + L.feels + '</span> ' + p.current.feels + '°</li>' +
            '<li><span>' + L.rainToday + '</span> ' + (p.daily[0] ? p.daily[0].precipProb : 0) + '%</li>' +
            '<li><span>' + L.wind + '</span> ' + p.current.wind + ' km/h</li>' +
            '<li><span>' + L.uv + '</span> ' + p.current.uv + '</li>' +
            '<li><span>' + L.humidity + '</span> ' + p.current.humidity + '%</li>' +
          '</ul>' +
        '</div>';
      fcEl.innerHTML = '<div class="forecast-list">' + p.daily.map((d) =>
        '<div class="forecast-day">' +
          '<span class="f-day">' + fmtDay(d.date) + '</span>' +
          '<span class="f-icon">' + d.icon + '</span>' +
          '<span class="f-label">' + d.label + '</span>' +
          '<span class="f-temp">' + d.tmax + '° / ' + d.tmin + '°</span>' +
          '<span class="f-rain">' + d.precipProb + '%</span>' +
          (d.umbrella ? '<span class="f-chip">☔</span>' : '') +
        '</div>'
      ).join('') + '</div>';
      renderAdvice(p.advice);
      if (upEl && p.updated) {
        upEl.textContent = L.updated + ': ' + new Date(p.updated).toLocaleString(lc, { timeZone: 'America/Argentina/Cordoba' }) + ' · UTC−3';
        upEl.hidden = false;
      }
    }

    function fail() {
      nowEl.innerHTML = '<div class="now-card"><p class="weather-loading">' + L.loadError + '</p></div>';
      fcEl.textContent = L.loadError;
      advEl.hidden = true;
      upEl.hidden = true;
    }

    const raw = section.getAttribute('data-initial');
    let didInitial = false;
    if (raw) {
      try { render(JSON.parse(raw)); didInitial = true; } catch (_) {}
    }
    fetch('/api/weather?lang=' + lang, { signal: AbortSignal.timeout(10000), cache: 'no-store' })
      .then((r) => { if (!r.ok) throw new Error('bad'); return r.json(); })
      .then(render)
      .catch(() => { if (!didInitial) fail(); });
  })();
</script>
